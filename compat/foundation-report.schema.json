{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Qaplet foundation evidence v2",
  "type": "object",
  "required": ["schema_version", "report_id", "scope", "started_at", "finished_at", "status", "m0_core_status", "source", "host", "ci", "qemu", "cases", "reason", "evidence_directory"],
  "properties": {
    "schema_version": {"enum": [2]},
    "report_id": {"type": "string", "minLength": 1},
    "scope": {"enum": ["doctor", "environment", "bootstrap", "m0", "check-ci", "validate-report"]},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["pass", "fail", "blocked", "not_run"]},
    "m0_core_status": {"enum": ["blocked", "not_run"]},
    "reason": {"type": "string", "minLength": 1},
    "evidence_directory": {"type": "string", "minLength": 1},
    "source": {
      "type": "object", "required": ["git_commit", "sha256", "files", "note"],
      "properties": {
        "git_commit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "files": {"type": "array", "minItems": 1, "items": {
          "type": "object", "required": ["path", "sha256"],
          "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
        }},
        "note": {"type": "string"}
      }
    },
    "host": {
      "type": "object", "required": ["os", "cpu", "execution_arch", "kernel", "page_size", "execution_mode", "measurement"],
      "properties": {
        "os": {"type": "string", "minLength": 1},
        "cpu": {"type": "string", "minLength": 1},
        "execution_arch": {"type": "string", "minLength": 1},
        "kernel": {"type": "string", "minLength": 1},
        "page_size": {"type": ["integer", "null"], "minimum": 1},
        "execution_mode": {"enum": ["native", "emulated-system", "unknown"]},
        "measurement": {"type": "string"}
      }
    },
    "ci": {"type": ["object", "null"]},
    "qemu": {"type": ["object", "null"]},
    "tools": {"type": "array", "items": {"type": "object", "required": ["name", "path", "version", "status", "reason", "command"]}},
    "cases": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["case_id", "status", "reason", "started_at", "finished_at", "commands", "expected", "actual", "exit_code", "timeout_seconds", "toolchain", "build", "artifact"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "status": {"enum": ["pass", "fail", "blocked", "not_run"]},
          "reason": {"type": "string", "minLength": 1},
          "started_at": {"type": "string", "format": "date-time"},
          "finished_at": {"type": "string", "format": "date-time"},
          "exit_code": {"type": ["integer", "null"]},
          "timeout_seconds": {"type": "integer", "minimum": 1},
          "toolchain": {"type": ["object", "null"]},
          "build": {"type": ["object", "null"]},
          "artifact": {
            "type": ["object", "null"], "required": ["path", "sha256", "size_bytes", "kind"],
            "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "size_bytes": {"type": "integer", "minimum": 1}, "kind": {"type": "string"}}
          },
          "commands": {
            "type": "array", "items": {
              "type": "object", "required": ["argv", "cwd", "started_at", "finished_at", "exit_code", "timeout_seconds", "timed_out", "stdout_log", "stderr_log"],
              "properties": {
                "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
                "cwd": {"type": "string"}, "started_at": {"type": "string", "format": "date-time"}, "finished_at": {"type": "string", "format": "date-time"},
                "exit_code": {"type": ["integer", "null"]}, "timeout_seconds": {"type": "integer", "minimum": 1}, "timed_out": {"type": "boolean"},
                "stdout_log": {"type": "string"}, "stderr_log": {"type": "string"}
              }
            }
          }
        }
      }
    }
  }
}

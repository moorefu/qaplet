+/* Module names cross a C-string-only host boundary. Ordinary JS strings and
+   property atoms retain their length-aware embedded-NUL semantics. */
+static const char *js_module_atom_to_cstring(JSContext *ctx, JSAtom atom)
+{
+    JSValue value = JS_AtomToValue(ctx, atom);
+    const char *name;
+    if (JS_IsException(value))
+        return NULL;
+    name = JS_ToCStringNZ(ctx, value);
+    JS_FreeValue(ctx, value);
+    return name;
+}
